[group("Repo")]
[doc("Default command; list all available commands.")]
@list:
  just --list --unsorted

[group("Test")]
[doc("Remove all build artifacts and installed dependencies.")]
clean:
  rm -rf node_modules/
  rm -rf android/build/

[group("Test")]
[doc("Run the tests on the Android application (needs a running emulator).")]
test:
  rm -rf node_modules/bdk-rn
  pnpm install --ignore-workspace
  # Reinstalling node_modules churns enough files that Watchman can drop events and
  # hand Metro a stale file map ("Unable to resolve module react"). Start from fresh watches.
  -watchman watch-del "{{justfile_directory()}}" > /dev/null 2>&1
  -watchman watch-del "{{parent_directory(justfile_directory())}}" > /dev/null 2>&1
  ./scripts/run-android-tests.sh
